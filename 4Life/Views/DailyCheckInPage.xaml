<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:_4Life.ViewModels"
             x:Class="_4Life.Views.DailyCheckInPage"
             x:DataType="viewmodel:DailyCheckInViewModel"
             Title="Daily Check-in"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="25,30">

            <!-- Header -->
            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                <Label Text="Good Morning! 👋"
                       FontSize="26" FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       HorizontalOptions="Center"/>
                <Label Text="How are you feeling today?"
                       FontSize="15" TextColor="Gray"
                       HorizontalOptions="Center"/>
                <!-- NOU — data calculata in ViewModel -->
                <Label Text="{Binding TodayDate}"
                       FontSize="13" TextColor="{StaticResource Gray400}"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Scor + emoji -->
            <Frame Padding="20,15"
                   BackgroundColor="{StaticResource Gray100}"
                   BorderColor="Transparent"
                   CornerRadius="16"
                   HasShadow="False">
                <VerticalStackLayout Spacing="10">

                    <Label Text="{Binding ScoreEmoji}"
                           FontSize="52"
                           HorizontalOptions="Center"/>

                    <Label Text="{Binding ScoreLabel}"
                           FontSize="18" FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           HorizontalOptions="Center"/>

                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="1" FontSize="13" TextColor="Gray"
                               VerticalOptions="Center"/>
                        <Slider Grid.Column="1"
                                Minimum="1" Maximum="10" Value="{Binding FeelingScore}"
                                MinimumTrackColor="{StaticResource Primary}"
                                MaximumTrackColor="{StaticResource Gray200}"
                                ThumbColor="{StaticResource Primary}"/>
                        <Label Grid.Column="2" Text="10" FontSize="13" TextColor="Gray"
                               VerticalOptions="Center"/>
                    </Grid>

                    <Label Text="{Binding FeelingScore, StringFormat='Score: {0}/10'}"
                           FontSize="13" TextColor="Gray"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Simptome -->
            <Label Text="Any symptoms today?"
                   FontSize="16" FontAttributes="Bold"
                   TextColor="{StaticResource Primary}"/>

            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto,Auto,Auto,Auto"
                  ColumnSpacing="10" RowSpacing="10">

                <!-- Col 0 -->
                <Frame Grid.Row="0" Grid.Column="0" Padding="12,10"
                       CornerRadius="12" HasShadow="False">
                    <Grid ColumnDefinitions="Auto, *">
                        <CheckBox Grid.Column="0" IsChecked="{Binding HasHeadache}"
                                  Color="{StaticResource Primary}"/>
                        <Label Grid.Column="1" Text="🤕 Headache"
                               VerticalOptions="Center" FontSize="13"/>
                    </Grid>
                </Frame>

                <Frame Grid.Row="1" Grid.Column="0" Padding="12,10"
                       CornerRadius="12" HasShadow="False">
                    <Grid ColumnDefinitions="Auto, *">
                        <CheckBox Grid.Column="0" IsChecked="{Binding HasNausea}"
                                  Color="{StaticResource Primary}"/>
                        <Label Grid.Column="1" Text="🤢 Nausea"
                               VerticalOptions="Center" FontSize="13"/>
                    </Grid>
                </Frame>

                <Frame Grid.Row="2" Grid.Column="0" Padding="12,10"
                       CornerRadius="12" HasShadow="False">
                    <Grid ColumnDefinitions="Auto, *">
                        <CheckBox Grid.Column="0" IsChecked="{Binding HasPain}"
                                  Color="{StaticResource Primary}"/>
                        <Label Grid.Column="1" Text="😣 Pain"
                               VerticalOptions="Center" FontSize="13"/>
                    </Grid>
                </Frame>

                <Frame Grid.Row="3" Grid.Column="0" Padding="12,10"
                       CornerRadius="12" HasShadow="False">
                    <Grid ColumnDefinitions="Auto, *">
                        <CheckBox Grid.Column="0" IsChecked="{Binding HasAnxiety}"
                                  Color="{StaticResource Primary}"/>
                        <Label Grid.Column="1" Text="😰 Anxiety"
                               VerticalOptions="Center" FontSize="13"/>
                    </Grid>
                </Frame>

                <!-- Col 1 -->
                <Frame Grid.Row="0" Grid.Column="1" Padding="12,10"
                       CornerRadius="12" HasShadow="False">
                    <Grid ColumnDefinitions="Auto, *">
                        <CheckBox Grid.Column="0" IsChecked="{Binding HasFatigue}"
                                  Color="{StaticResource Primary}"/>
                        <Label Grid.Column="1" Text="😴 Fatigue"
                               VerticalOptions="Center" FontSize="13"/>
                    </Grid>
                </Frame>

                <Frame Grid.Row="1" Grid.Column="1" Padding="12,10"
                       CornerRadius="12" HasShadow="False">
                    <Grid ColumnDefinitions="Auto, *">
                        <CheckBox Grid.Column="0" IsChecked="{Binding HasDizziness}"
                                  Color="{StaticResource Primary}"/>
                        <Label Grid.Column="1" Text="💫 Dizziness"
                               VerticalOptions="Center" FontSize="13"/>
                    </Grid>
                </Frame>

                <Frame Grid.Row="2" Grid.Column="1" Padding="12,10"
                       CornerRadius="12" HasShadow="False">
                    <Grid ColumnDefinitions="Auto, *">
                        <CheckBox Grid.Column="0" IsChecked="{Binding HasBreathingDifficulty}"
                                  Color="{StaticResource Primary}"/>
                        <Label Grid.Column="1" Text="😮‍💨 Breathing"
                               VerticalOptions="Center" FontSize="13"/>
                    </Grid>
                </Frame>

                <Frame Grid.Row="3" Grid.Column="1" Padding="12,10"
                       CornerRadius="12" HasShadow="False">
                    <Grid ColumnDefinitions="Auto, *">
                        <CheckBox Grid.Column="0" IsChecked="{Binding HasFever}"
                                  Color="{StaticResource Primary}"/>
                        <Label Grid.Column="1" Text="🌡️ Fever"
                               VerticalOptions="Center" FontSize="13"/>
                    </Grid>
                </Frame>
            </Grid>

            <!-- Note libere -->
            <Label Text="Anything else?" FontSize="15" FontAttributes="Bold"
                   TextColor="{StaticResource Primary}"/>

            <Editor Placeholder="Optional notes..."
                    Text="{Binding Notes}"
                    HeightRequest="90"
                    BackgroundColor="{StaticResource Gray100}"/>

            <!-- Butoane -->
            <Button Text="✅ Submit Check-in"
                    Command="{Binding SubmitCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="25"
                    HeightRequest="52"
                    FontAttributes="Bold"
                    Margin="0,8,0,0"/>

            <Button Text="Skip for today"
                    Command="{Binding SkipCommand}"
                    BackgroundColor="Transparent"
                    TextColor="Gray"
                    FontSize="13"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
