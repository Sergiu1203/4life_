<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:_4Life.ViewModels"
             x:Class="_4Life.Views.LoginPage"
             x:DataType="viewmodels:LoginViewModel"
             Title="Login"
             BackgroundColor="White">

    <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">

        <Border HorizontalOptions="Center" StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="60"/>
            </Border.StrokeShape>
            <Image Source="logo.jpeg" HeightRequest="120" WidthRequest="120" Aspect="AspectFill"/>
        </Border>

        <Label Text="Welcome Back!"
               FontSize="26" FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="{StaticResource Primary}"/>

        <Entry Placeholder="Email Address"
               Text="{Binding Email}"
               Keyboard="Email"/>

        <Entry Placeholder="Password"
               Text="{Binding Password}"
               IsPassword="True"/>

        <Button Text="LOG IN"
                Command="{Binding LoginCommand}"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White" CornerRadius="25"
                HeightRequest="50" Margin="0,10,0,0"/>

        <!-- Buton Forgot Password — nou -->
        <Button Text="Forgot Password?"
                Command="{Binding GoToForgotPasswordCommand}"
                BackgroundColor="Transparent"
                TextColor="{StaticResource Primary}"
                FontSize="13"/>

        <Button Text="Don't have an account? Register"
                Command="{Binding GoToRegisterCommand}"
                BackgroundColor="Transparent"
                TextColor="{StaticResource Secondary}"
                FontSize="13"/>

    </VerticalStackLayout>
</ContentPage>
