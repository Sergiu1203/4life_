<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:_4Life.ViewModels"
             xmlns:models="clr-namespace:_4Life.Models"
             x:Class="_4Life.Views.AdminDashboardPage"
             x:DataType="viewmodel:AdminDashboardViewModel"
             Title="Admin Panel">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Logout" Command="{Binding LogoutCommand}"/>
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="15">

            <Label Text="👥 Patients" FontSize="22" FontAttributes="Bold"
                   TextColor="{StaticResource Primary}"/>

            <CollectionView ItemsSource="{Binding AllPatients}">
                <CollectionView.EmptyView>
                    <Label Text="No patients registered." TextColor="Gray" Margin="10"/>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Patient">
                        <Frame Margin="0,5" Padding="15" CornerRadius="10">
                            <HorizontalStackLayout Spacing="12">
                                <VerticalStackLayout WidthRequest="200">
                                    <Label Text="{Binding FullName}"
                                           FontAttributes="Bold" FontSize="16"/>
                                    <Label Text="{Binding Age, StringFormat='Age: {0}'}"
                                           TextColor="Gray" FontSize="12"/>
                                </VerticalStackLayout>
                                <Button Text="Edit"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:AdminDashboardViewModel}}, Path=EditPatientCommand}"
                                        CommandParameter="{Binding .}"/>
                                <Button Text="Delete" BackgroundColor="Red" TextColor="White"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:AdminDashboardViewModel}}, Path=DeletePatientCommand}"
                                        CommandParameter="{Binding .}"/>
                            </HorizontalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="🩺 Doctors" FontSize="22" FontAttributes="Bold"
                   TextColor="{StaticResource Primary}" Margin="0,10,0,0"/>

            <CollectionView ItemsSource="{Binding AllDoctors}">
                <CollectionView.EmptyView>
                    <Label Text="No doctors registered." TextColor="Gray" Margin="10"/>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Doctor">
                        <Frame Margin="0,5" Padding="15" CornerRadius="10">
                            <HorizontalStackLayout Spacing="12">
                                <VerticalStackLayout WidthRequest="180">
                                    <Label Text="{Binding FullName}"
                                           FontAttributes="Bold" FontSize="16"/>
                                    <Label Text="{Binding Specialization}"
                                           TextColor="Gray" FontSize="12"/>
                                    <Label Text="{Binding MedicalId, StringFormat='ID: {0}'}"
                                           TextColor="Gray" FontSize="11"/>
                                </VerticalStackLayout>

                                <!-- Buton Edit — nou -->
                                <Button Text="Edit"
                                        BackgroundColor="Orange" TextColor="White"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:AdminDashboardViewModel}}, Path=EditDoctorCommand}"
                                        CommandParameter="{Binding .}"/>

                                <Button Text="Delete"
                                        BackgroundColor="Red" TextColor="White"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:AdminDashboardViewModel}}, Path=DeleteDoctorCommand}"
                                        CommandParameter="{Binding .}"/>
                            </HorizontalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
