<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:_4Life.ViewModels"
             x:Class="_4Life.Views.ForgotPasswordPage"
             x:DataType="viewmodel:ForgotPasswordViewModel"
             Title="Reset Password"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Spacing="18" Padding="30" VerticalOptions="Center">

            <!-- Logo -->
            <Border HorizontalOptions="Center" StrokeThickness="0" Margin="0,0,0,5">
                <Border.StrokeShape><RoundRectangle CornerRadius="60"/></Border.StrokeShape>
                <Image Source="logo.jpeg" HeightRequest="110" WidthRequest="110" Aspect="AspectFill"/>
            </Border>

            <Label Text="Forgot Password"
                   FontSize="24" FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource Primary}"/>

            <Label Text="Enter your email to reset your password."
                   FontSize="13" TextColor="Gray"
                   HorizontalOptions="Center"
                   Margin="0,0,0,10"/>

            <!-- PASUL 1: email -->
            <Entry Placeholder="Email Address"
                   Text="{Binding Email}"
                   Keyboard="Email"
                   IsEnabled="{Binding EmailVerified, Converter={StaticResource InverseBoolConverter}}"/>

            <Button Text="VERIFY EMAIL"
                    Command="{Binding VerifyEmailCommand}"
                    BackgroundColor="{StaticResource Secondary}"
                    TextColor="White"
                    CornerRadius="20"
                    HeightRequest="46"
                    IsVisible="{Binding EmailVerified, Converter={StaticResource InverseBoolConverter}}"/>

            <!-- Mesaj status -->
            <Label Text="{Binding StatusMessage}"
                   TextColor="{Binding StatusColor}"
                   FontSize="13" FontAttributes="Italic"
                   HorizontalOptions="Center"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}"/>

            <!-- PASUL 2: parola noua — apare dupa verificarea email-ului -->
            <VerticalStackLayout IsVisible="{Binding EmailVerified}" Spacing="14">

                <Label Text="Set New Password"
                       FontSize="18" FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       Margin="0,10,0,0"/>

                <Entry Placeholder="New Password"
                       Text="{Binding NewPassword}"
                       IsPassword="True"/>

                <Label Text="{Binding PasswordStrengthMessage}"
                       TextColor="{Binding StrengthColor}"
                       FontSize="12" FontAttributes="Italic"
                       Margin="4,-8,0,0"
                       IsVisible="{Binding PasswordStrengthMessage, Converter={StaticResource StringToBoolConverter}}"/>

                <Entry Placeholder="Confirm New Password"
                       Text="{Binding ConfirmPassword}"
                       IsPassword="True"/>

                <Button Text="RESET PASSWORD"
                        Command="{Binding ResetPasswordCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        CornerRadius="25"
                        HeightRequest="50"
                        Margin="0,8,0,0"/>
            </VerticalStackLayout>

            <Button Text="Back to Login"
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    FontSize="13"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
