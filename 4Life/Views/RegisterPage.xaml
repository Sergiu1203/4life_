<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="_4Life.Views.RegisterPage"
             Title="Register"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="30" VerticalOptions="Center">

            <Border HorizontalOptions="Center"
                    StrokeThickness="0"
                    Margin="0,0,0,10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="100" />
                </Border.StrokeShape>

                <Image Source="logo.jpeg"
                        HeightRequest="150"
                        WidthRequest="150"
                        Aspect="AspectFill" />
            </Border>

            <Label  Text="Create your 4Life Account" 
                    FontSize="24" FontAttributes="Bold"
                    HorizontalOptions="Center" 
                    TextColor="{StaticResource Primary}" Margin="0,0,0,20"/>

            <Entry Placeholder="Full Name" 
                   Text="{Binding FullName}" 
                   PlaceholderColor="{StaticResource Gray400}"/>

            <Entry Placeholder="Email Address" 
                   Text="{Binding Email}" 
                   Keyboard="Email"
                   PlaceholderColor="{StaticResource Gray400}"/>

            <Entry Placeholder="Password" 
                   Text="{Binding Password}" 
                   IsPassword="True"
                   PlaceholderColor="{StaticResource Gray400}"/>

            <Label Text="Select your role:" 
                   TextColor="{StaticResource Secondary}" 
                   FontAttributes="Bold" 
                   Margin="0,10,0,0"/>

            <Picker Title="-- Choose Role --" 
                    ItemsSource="{Binding Roles}" 
                    SelectedItem="{Binding SelectedRole}"
                    TextColor="{StaticResource Primary}"/>

            <Entry Placeholder="Specialization" 
                   Text="{Binding Specialization}" 
                   IsVisible="{Binding IsDoctor}"
                   PlaceholderColor="{StaticResource Gray400}"/>

            <Entry Placeholder="Medical License Number" 
                   Text="{Binding MedicalId}" 
                   IsVisible="{Binding IsDoctor}"
                   PlaceholderColor="{StaticResource Gray400}"/>

            <Entry Placeholder="Age" 
                   Text="{Binding Age}" 
                   Keyboard="Numeric"
                   IsVisible="{Binding IsPatient}"
                   PlaceholderColor="{StaticResource Gray400}"/>

            <Button Text="REGISTER" 
                    Command="{Binding RegisterUserCommand}" 
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="25"
                    HeightRequest="50"
                    Margin="0,20,0,0" />

            <Button Text="Already have an account? Log In"
                    Command="{Binding GoToLoginCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    FontSize="12" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
