<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:_4Life.ViewModels"
             xmlns:models="clr-namespace:_4Life.Models"
             x:Class="_4Life.Views.DashboardPage"
             x:DataType="viewmodel:DashboardViewModel"
             Title="4Life Dashboard"
             BackgroundColor="White">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Logout" Command="{Binding LogoutCommand}"/>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto, Auto, *, Auto" Padding="16,12,16,0" RowSpacing="8">

        <!-- ROW 0: Salut + badge mesaje noi -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" ColumnSpacing="10">
            <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                <Label Text="{Binding UserName, StringFormat='Hello, {0} 👋'}"
                       FontSize="20" FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"/>
                <Label Text="Your medications for today"
                       FontSize="12" TextColor="{StaticResource Gray500}"/>
            </VerticalStackLayout>
            <Frame Grid.Column="1"
                   IsVisible="{Binding HasUnread}"
                   BackgroundColor="Red" BorderColor="Transparent"
                   CornerRadius="14" Padding="10,4" VerticalOptions="Center">
                <Label Text="{Binding UnreadCount, StringFormat='{0} new 💬'}"
                       TextColor="White" FontSize="11" FontAttributes="Bold"/>
            </Frame>
        </Grid>

        <!-- ROW 1: SearchBar -->
        <SearchBar Grid.Row="1"
                   Placeholder="Search medicines…"
                   Text="{Binding SearchQuery}"
                   BackgroundColor="{StaticResource Gray100}"
                   HeightRequest="42"/>

        <!-- ROW 2: LISTA MEDICAMENTE -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding DailyMeds}" Margin="0,4,0,0">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                    <Label Text="💊" FontSize="40" HorizontalOptions="Center"/>
                    <Label Text="No medications for today." HorizontalOptions="Center"
                           TextColor="Gray" FontSize="14"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:MedicineEntry">
                    <Grid ColumnDefinitions="Auto, *, Auto"
                          ColumnSpacing="12" Padding="4,7">

                        <!-- Emoji momento -->
                        <Label Grid.Column="0"
                               Text="{Binding MealEmoji}"
                               FontSize="26" VerticalOptions="Center"/>

                        <!-- Info medicament -->
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">

                            <!-- Linia 1: Nume + badge sursa + badge moment -->
                            <HorizontalStackLayout Spacing="5">
                                <Label Text="{Binding Name}"
                                       FontAttributes="Bold" FontSize="15"
                                       VerticalOptions="Center"/>

                                <Border BackgroundColor="{Binding SourceColor}"
                                        StrokeThickness="0" Padding="5,2">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="5"/></Border.StrokeShape>
                                    <Label Text="{Binding SourceLabel}"
                                           FontSize="9" FontAttributes="Bold" TextColor="White"/>
                                </Border>

                                <Border BackgroundColor="{StaticResource Primary}"
                                        StrokeThickness="0" Padding="5,2">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="5"/></Border.StrokeShape>
                                    <Label Text="{Binding MealTime}"
                                           FontSize="9" FontAttributes="Bold" TextColor="White"/>
                                </Border>
                            </HorizontalStackLayout>

                            <!-- Linia 2: Doza + Stoc -->
                            <HorizontalStackLayout Spacing="8">
                                <!-- Doza — afisata cu accent -->
                                <HorizontalStackLayout Spacing="3">
                                    <Label Text="💊" FontSize="11"/>
                                    <Label Text="{Binding DoseLabel}"
                                           FontSize="12" FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}"/>
                                </HorizontalStackLayout>

                                <Label Text="·" FontSize="12" TextColor="{StaticResource Gray300}"
                                       VerticalOptions="Center"/>

                                <!-- Stoc -->
                                <HorizontalStackLayout Spacing="3">
                                    <Label Text="Stock:" FontSize="11" TextColor="Gray"
                                           VerticalOptions="Center"/>
                                    <Label Text="{Binding StockQuantity}"
                                           FontSize="12" FontAttributes="Bold"
                                           TextColor="{Binding StockQuantity, Converter={StaticResource StockToColorConverter}}"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <!-- Dreapta: Checkbox + buton delete OTC -->
                        <VerticalStackLayout Grid.Column="2"
                                             VerticalOptions="Center"
                                             HorizontalOptions="End"
                                             Spacing="2">
                            <CheckBox IsChecked="{Binding IsTaken}"
                                      Color="{StaticResource Primary}"
                                      HorizontalOptions="Center"
                                      CheckedChanged="OnMedicationCheckedChanged"/>

                            <Button Text="🗑" FontSize="14"
                                    IsVisible="{Binding IsOtc}"
                                    BackgroundColor="Transparent"
                                    TextColor="Red" Padding="0"
                                    HeightRequest="28" WidthRequest="28"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:DashboardViewModel}}, Path=DeleteOwnMedicineCommand}"
                                    CommandParameter="{Binding .}"/>
                        </VerticalStackLayout>

                        <!-- Separator subtil -->
                        <BoxView Grid.ColumnSpan="3" HeightRequest="0.5"
                                 Color="{StaticResource Gray200}"
                                 VerticalOptions="End" Margin="0,6,0,0"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ROW 3: BARA DE JOS FIXA -->
        <VerticalStackLayout Grid.Row="3" Spacing="0" BackgroundColor="White">

            <BoxView HeightRequest="0.5" Color="{StaticResource Gray200}" Margin="0,0,0,8"/>

            <!-- Butoane actiuni principale -->
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8" Margin="0,0,0,8">
                <Button Grid.Column="0" Text="🚨"
                        FontSize="20" Command="{Binding SosContactCommand}"
                        BackgroundColor="#FFEBEE" TextColor="Red"
                        CornerRadius="22" HeightRequest="44" WidthRequest="44" Padding="0"/>

                <Button Grid.Column="1" Text="➕ Add My Own Medicine"
                        Command="{Binding AddOwnMedicineCommand}"
                        BackgroundColor="#5C6BC0" TextColor="White"
                        CornerRadius="22" HeightRequest="44" FontSize="13"/>

                <Button Grid.Column="2" Text="📓"
                        FontSize="20" Command="{Binding GoToJournalCommand}"
                        BackgroundColor="#E8EAF6" TextColor="#2B3A67"
                        CornerRadius="22" HeightRequest="44" WidthRequest="44" Padding="0"/>
            </Grid>

            <!-- My Doctors — collapsible -->
            <Grid ColumnDefinitions="*, Auto" Padding="4,6"
                  BackgroundColor="{StaticResource Gray100}">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleDoctorPanelCommand}"/>
                </Grid.GestureRecognizers>
                <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                    <Label Text="⚕️ My Doctors" FontAttributes="Bold" FontSize="14"
                           VerticalOptions="Center"/>
                    <Frame IsVisible="{Binding HasUnread}"
                           BackgroundColor="Red" BorderColor="Transparent"
                           CornerRadius="10" Padding="6,2">
                        <Label Text="{Binding UnreadCount, StringFormat='{0}'}"
                               TextColor="White" FontSize="11" FontAttributes="Bold"/>
                    </Frame>
                </HorizontalStackLayout>
                <Label Grid.Column="1" Text="{Binding DoctorPanelArrow}"
                       FontSize="16" VerticalOptions="Center"
                       TextColor="Gray" Margin="0,0,6,0"/>
            </Grid>

            <VerticalStackLayout IsVisible="{Binding DoctorPanelOpen}"
                                 BackgroundColor="White" Padding="4,4,4,8" Spacing="0">
                <CollectionView ItemsSource="{Binding MyDoctors}">
                    <CollectionView.EmptyView>
                        <Label Text="No doctors assigned." TextColor="Gray"
                               FontSize="12" Margin="8,6"/>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Doctor">
                            <Grid ColumnDefinitions="Auto, *, Auto" Padding="4,8" ColumnSpacing="10">
                                <Border Grid.Column="0" BackgroundColor="{StaticResource Primary}"
                                        StrokeThickness="0" HeightRequest="36" WidthRequest="36">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="18"/></Border.StrokeShape>
                                    <Label Text="{Binding FullName, Converter={StaticResource InitialsConverter}}"
                                           TextColor="White" FontSize="13" FontAttributes="Bold"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                    <Label Text="{Binding FullName}" FontAttributes="Bold" FontSize="13"/>
                                    <Label Text="{Binding Specialization}" FontSize="11" TextColor="Gray"/>
                                </VerticalStackLayout>
                                <Button Grid.Column="2" Text="💬" FontSize="16"
                                        BackgroundColor="{StaticResource Primary}" TextColor="White"
                                        CornerRadius="18" HeightRequest="36" WidthRequest="36" Padding="0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:DashboardViewModel}}, Path=OpenChatCommand}"
                                        CommandParameter="{Binding .}"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Button Text="⚕️ Manage Doctors" Command="{Binding ManageDoctorsCommand}"
                        BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
                        FontSize="12" HeightRequest="36" Margin="0,4,0,0"/>
            </VerticalStackLayout>

            <BoxView HeightRequest="8" Color="Transparent"/>
        </VerticalStackLayout>

    </Grid>
</ContentPage>
