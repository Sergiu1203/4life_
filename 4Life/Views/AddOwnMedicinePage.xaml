<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:_4Life.ViewModels"
             xmlns:data="clr-namespace:_4Life.Data"
             x:Class="_4Life.Views.AddOwnMedicinePage"
             x:DataType="viewmodel:AddOwnMedicineViewModel"
             Title="Add My Medicine"
             BackgroundColor="White">

    <!-- NOU — inlocuieste ScrollView-ul existent -->
    <Grid>
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding DismissSuggestionsCommand}"/>
        </Grid.GestureRecognizers>

        <ScrollView>
            <VerticalStackLayout Spacing="18" Padding="25">

                <Label Text="Add Your Own Medicine"
               FontSize="22" FontAttributes="Bold"
               TextColor="{StaticResource Primary}"/>

                <Label Text="For over-the-counter medicines or supplements."
               FontSize="13" TextColor="Gray"/>

                <!-- ===== CAMP CAUTARE CU AUTOFILL ===== -->
                <Label Text="Medicine name:" FontAttributes="Bold" TextColor="Gray"/>

                <VerticalStackLayout Spacing="0">

                    <Entry Placeholder="Type to search (e.g. Vitamin C, Ibuprofen…)"
                   Text="{Binding MedName}"
                   ReturnType="Next"/>

                    <Frame IsVisible="{Binding ShowSuggestions}"
                   Padding="0"
                   BorderColor="{StaticResource Gray200}"
                   CornerRadius="8"
                   HasShadow="True"
                   Margin="0,-2,0,0">
                        <CollectionView ItemsSource="{Binding FilteredSuggestions}"
                                MaximumHeightRequest="220">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="data:MedicineSuggestion">
                                    <Grid ColumnDefinitions="*, Auto"
                                  Padding="14,10"
                                  BackgroundColor="White">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:AddOwnMedicineViewModel}}, Path=SelectSuggestionCommand}"
                                        CommandParameter="{Binding .}"/>
                                        </Grid.GestureRecognizers>

                                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                                            <Label Text="{Binding Name}"
                                           FontAttributes="Bold" FontSize="14"/>
                                            <Label Text="{Binding Category}"
                                           FontSize="11" TextColor="Gray"/>
                                        </VerticalStackLayout>

                                        <Label Grid.Column="1"
                                       Text="{Binding SuggestedDosage}"
                                       FontSize="12"
                                       TextColor="{StaticResource Primary}"
                                       VerticalOptions="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Frame>
                </VerticalStackLayout>

                <Entry Placeholder="Dosage (e.g., 500mg) — auto-filled from list"
               Text="{Binding Dosage}"/>

                <Entry Placeholder="Quantity in stock"
               Text="{Binding InitialStock}"
               Keyboard="Numeric"/>

                <!-- ===== ORE DE ADMINISTRARE ===== -->
                <Label Text="When do you take it?" FontAttributes="Bold" TextColor="Gray"/>

                <Frame Padding="15,10" BorderColor="{StaticResource Gray200}"
               CornerRadius="10" HasShadow="False">
                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="Auto, Auto, *" ColumnSpacing="10">
                            <CheckBox Grid.Column="0" IsChecked="{Binding TakeMorning}"
                              Color="{StaticResource Primary}" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="🌅" FontSize="20" VerticalOptions="Center"/>
                            <Label Grid.Column="2" Text="Morning" FontSize="16" VerticalOptions="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto, Auto, *" ColumnSpacing="10">
                            <CheckBox Grid.Column="0" IsChecked="{Binding TakeLunch}"
                              Color="{StaticResource Primary}" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="☀️" FontSize="20" VerticalOptions="Center"/>
                            <Label Grid.Column="2" Text="Lunch" FontSize="16" VerticalOptions="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto, Auto, *" ColumnSpacing="10">
                            <CheckBox Grid.Column="0" IsChecked="{Binding TakeDinner}"
                              Color="{StaticResource Primary}" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="🌙" FontSize="20" VerticalOptions="Center"/>
                            <Label Grid.Column="2" Text="Dinner" FontSize="16" VerticalOptions="Center"/>
                        </Grid>

                    </VerticalStackLayout>
                </Frame>

                <Label Text="{Binding TimesError}"
               TextColor="Red" FontSize="12"
               IsVisible="{Binding TimesError, Converter={StaticResource StringToBoolConverter}}"/>

                <Button Text="ADD MEDICINE"
                Command="{Binding SaveCommand}"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White" CornerRadius="25"
                HeightRequest="50" Margin="0,10,0,0"/>

                <Button Text="Cancel"
                Command="{Binding CancelCommand}"
                BackgroundColor="Transparent"
                TextColor="Gray" FontSize="13"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

    
</ContentPage>
