<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:_4Life.ViewModels"
             xmlns:models="clr-namespace:_4Life.Models"
             x:Class="_4Life.Views.SymptomJournalPage"
             x:DataType="viewmodel:SymptomJournalViewModel"
             Title="My Health Journal">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- ===== NOTE LIBERE ===== -->
            <Label Text="📝 Personal Notes"
                   FontSize="20" FontAttributes="Bold"
                   TextColor="{StaticResource Primary}"/>

            <Label Text="Write anything you want to share with your doctor:"
                   FontSize="13" TextColor="Gray"/>

            <Frame BorderColor="{StaticResource Gray200}" CornerRadius="10" Padding="5">
                <Editor Text="{Binding JournalText, Mode=TwoWay}"
                        Placeholder="Enter your notes here..."
                        HeightRequest="180"
                        AutoSize="TextChanges"/>
            </Frame>

            <Button Text="SAVE NOTES"
                    Command="{Binding SaveJournalCommand}"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    CornerRadius="10"
                    FontAttributes="Bold"/>

            <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,5"/>

            <!-- ===== MEDICAMENTE LUATE AZI ===== -->
            <Label Text="💊 Medications Taken Today"
                   FontSize="20" FontAttributes="Bold"
                   TextColor="{StaticResource Primary}"/>

            <CollectionView ItemsSource="{Binding TakenMedsToday}">
                <CollectionView.EmptyView>
                    <Label Text="No medications marked as taken today."
                           HorizontalOptions="Center"
                           TextColor="Gray" FontSize="13"
                           Margin="0,10"/>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodel:TakenMedEntry">
                        <Frame Margin="0,4" Padding="12,10"
                               BorderColor="{StaticResource Gray200}"
                               CornerRadius="10" HasShadow="False">
                            <Grid ColumnDefinitions="Auto, *, Auto">

                                <!-- Emoji moment -->
                                <Label Grid.Column="0"
                                       Text="{Binding MealEmoji}"
                                       FontSize="22"
                                       VerticalOptions="Center"/>

                                <!-- Detalii -->
                                <VerticalStackLayout Grid.Column="1"
                                                     Margin="10,0" Spacing="1"
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding Name}"
                                           FontAttributes="Bold" FontSize="15"/>
                                    <Label Text="{Binding Dosage}"
                                           FontSize="12" TextColor="Gray"/>
                                </VerticalStackLayout>

                                <!-- Badge moment -->
                                <Frame Grid.Column="2"
                                       Padding="8,3"
                                       BackgroundColor="{StaticResource Primary}"
                                       BorderColor="Transparent"
                                       CornerRadius="8"
                                       VerticalOptions="Center">
                                    <Label Text="{Binding MealTime}"
                                           FontSize="11" FontAttributes="Bold"
                                           TextColor="White"/>
                                </Frame>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,5"/>

            <!-- ===== ISTORICUL CHECK-IN-URILOR ===== -->
            <Label Text="📋 Daily Check-in History"
                   FontSize="20" FontAttributes="Bold"
                   TextColor="{StaticResource Primary}"/>

            <!-- Daca exista check-in-uri, le afisam formatat -->
            <VerticalStackLayout IsVisible="{Binding HasCheckInHistory}" Spacing="8">
                <Label Text="Last 10 check-ins, most recent first."
                       FontSize="12" TextColor="Gray"/>

                <Frame Padding="15"
                       BackgroundColor="{StaticResource Gray100}"
                       BorderColor="Transparent"
                       CornerRadius="12">
                    <Label Text="{Binding CheckInHistory}"
                           FontSize="13"
                           LineHeight="1.5"
                           TextColor="{StaticResource Gray600}"/>
                </Frame>
            </VerticalStackLayout>

            <Label IsVisible="{Binding HasCheckInHistory, Converter={StaticResource InverseBoolConverter}}"
                   Text="No check-in history yet. Complete your first daily check-in!"
                   TextColor="Gray" FontSize="13"
                   HorizontalOptions="Center"
                   Margin="0,5"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
